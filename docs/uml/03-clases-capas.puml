alquileres_rutas ..> alquileres_modelos
alquileres_rutas --> alquileres_servicio
alquileres_servicio --> alquileres_modelos
main --> alquileres_rutas : enrutador_alquileres
clima_rutas --> clima_proveedor
clima_rutas --> clima_servicio
clima_servicio --> clima_proveedor
main --> clima_rutas : enrutador_clima
domicilios_rutas ..> domicilios_modelos
domicilios_rutas --> domicilios_servicio
domicilios_servicio --> domicilios_modelos
main --> domicilios_rutas : enrutador_domicilios
inventario_gestion --> inventario_modelos
inventario_gestion --> inventario_servicio
inventario_rutas ..> inventario_modelos
inventario_rutas --> inventario_servicio
inventario_rutas_gestion --> inventario_gestion
inventario_rutas_gestion ..> inventario_modelos
inventario_servicio --> inventario_modelos
main --> inventario_rutas : enrutador_catalogo, enrutador_vehiculos
main --> inventario_rutas_gestion : enrutador_inventario
pagos_comprobante --> pagos_modelos
pagos_pasarela --> pagos_modelos
pagos_procesamiento --> pagos_modelos
pagos_procesamiento --> pagos_pasarela
pagos_procesamiento --> pagos_servicio
pagos_rutas --> pagos_comprobante
pagos_rutas ..> pagos_modelos
pagos_rutas --> pagos_pasarela
pagos_rutas --> pagos_procesamiento
pagos_servicio --> pagos_modelos
pagos_servicio --> pagos_pasarela
main --> pagos_rutas : enrutador_pagos
portal_rutas ..> portal_modelos
portal_rutas --> portal_servicio
portal_servicio --> portal_modelos
main --> portal_rutas : enrutador_portal
rastreo_rutas --> rastreo_servicio
rastreo_servicio --> rastreo_modelos
main --> rastreo_rutas : enrutador_rastreo
reportes_documentos --> reportes_modelos
reportes_rutas --> reportes_documentos
reportes_rutas ..> reportes_modelos
reportes_rutas --> reportes_servicio
reportes_servicio --> reportes_documentos
reportes_servicio --> reportes_modelos
main --> reportes_rutas : enrutador_actas
usuarios_rutas ..> usuarios_modelos
usuarios_rutas --> usuarios_servicio
usuarios_servicio --> usuarios_modelos
main --> usuarios_rutas : enrutador_autenticacion, enrutador_usuarios
ventas_rutas ..> ventas_modelos
ventas_rutas --> ventas_servicio
ventas_servicio --> ventas_modelos
main --> ventas_rutas : enrutador_ventas
@enduml
