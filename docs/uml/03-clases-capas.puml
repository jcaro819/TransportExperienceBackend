@startuml
' GENERADO por scripts/generar_uml.py desde el código. No editar a mano.
!include estilo.iuml
title Diagrama de clases por capas — rutas.py → servicio.py → modelos.py de cada módulo

set separator none
left to right direction

class "app/main.py" as main <<control maestro>> {
  app = FastAPI(...)
  registrar_manejadores(app)
  app.include_router(enrutador_autenticacion)
  app.include_router(enrutador_usuarios)
  app.include_router(enrutador_catalogo)
  app.include_router(enrutador_vehiculos)
  app.include_router(enrutador_inventario)
  app.include_router(enrutador_portal)
  app.include_router(enrutador_alquileres)
  app.include_router(enrutador_ventas)
  app.include_router(enrutador_pagos)
  app.include_router(enrutador_domicilios)
  app.include_router(enrutador_rastreo)
  app.include_router(enrutador_actas)
  app.include_router(enrutador_clima)
  --
  GET /salud → salud()
}

package "app/modulos/alquileres\n<size:10>además: consultas.py, esquemas.py, estados.py, excepciones.py</size>" {
  class "rutas.py" as alquileres_rutas <<rutas>> {
    POST /alquileres → crear()
    GET /alquileres/mios → listar_mios()
    GET /alquileres/en-riesgo → listar_en_riesgo()
    GET /alquileres → listar()
    GET /alquileres/{alquiler_id} → ver()
    POST /alquileres/{alquiler_id}/pago → pagar()
    POST /alquileres/{alquiler_id}/cancelacion → cancelar()
    POST /alquileres/{alquiler_id}/cancelacion-con-devolucion → cancelar_con_devolucion()
    POST /alquileres/{alquiler_id}/entrega → entregar()
    POST /alquileres/{alquiler_id}/devolucion → recibir()
    POST /alquileres/{alquiler_id}/reasignacion → reasignar()
  }
  class "servicio.py" as alquileres_servicio <<servicio>> {
    calcular_subtotal()
    validar_fechas()
    esta_vencido()
    estado_vigente()
    expirar_vencidos()
    crear_alquiler()
    bloquear_del_cliente()
    preparar_pago()
    aplicar_resultado_pago()
    cancelar_alquiler()
    cancelar_con_devolucion()
    listar_alquileres()
    obtener_alquiler()
    entregar_vehiculo()
    poner_en_curso()
    recibir_vehiculo()
    listar_en_riesgo()
    reasignar_alquiler()
  }
  class "modelos.py" as alquileres_modelos <<modelos>> {
    enum EstadoAlquiler
    Alquiler  <<alquileres>>
  }
}

package "app/modulos/clima\n<size:10>además: esquemas.py, excepciones.py, open_meteo.py</size>" {
  class "rutas.py" as clima_rutas <<rutas>> {
    GET /clima/pronostico → pronostico()
